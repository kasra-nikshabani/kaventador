// اسکیمای دیتابیس کاوِنتادور
//
// آینه‌ای از تایپ‌های دامنه در `src/types`. هر تغییری آنجا باید اینجا
// هم منعکس شود — تا وقتی مهاجرت انجام نشده، `src/types` منبع حقیقت است.
//
// هدف PostgreSQL است چون به آرایه بومی نیاز داریم (outcomes، prerequisites،
// skills). اگر روزی SQLite لازم شد، آن آرایه‌ها باید به جدول جداگانه یا
// رشته JSON تبدیل شوند.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// نشانی اتصال از نسخه ۷ به `prisma.config.ts` منتقل شده است؛
// اسکیما فقط شکل داده را توصیف می‌کند و از محیط اجرا بی‌خبر است.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
//  شمارش‌ها — دقیقاً معادل union typeهای TypeScript
// ─────────────────────────────────────────────────────────────

enum Level {
  beginner
  intermediate
  advanced
}

enum ContentStatus {
  draft
  published
  archived
}

/// وضعیت برگزاری دوره — عمداً از ContentStatus جداست.
enum CourseProgress {
  upcoming
  ongoing
  completed
}

enum LessonType {
  video
  article
  quiz
  project
}

enum UserRole {
  admin
  instructor
  student
}

enum UserStatus {
  active
  inactive
  banned
}

/// نوع قیمت‌گذاری دوره.
enum PricingType {
  free
  paid
}

/// وضعیت ثبت‌نام. دوره رایگان مستقیم `active` می‌شود؛ دوره پولی
/// `awaiting_payment` می‌گیرد و درس‌هایش تا تأیید پرداخت قفل می‌ماند.
enum EnrollmentStatus {
  active
  awaiting_payment
  cancelled
}

// ─────────────────────────────────────────────────────────────
//  محتوا
// ─────────────────────────────────────────────────────────────

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  titleEn     String
  description String
  icon        String
  color       String
  order       Int

  courses  Course[]
  articles Article[]

  @@index([order])
}

/// مدرس یا نویسنده. عمداً یک موجودیت مشترک است.
model Person {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  role   String
  bio    String
  avatar String @default("")

  githubUrl   String?
  linkedinUrl String?
  xUrl        String?
  telegramUrl String?
  websiteUrl  String?

  courses  Course[]
  articles Article[]

  /// حسابی که این پروفایل عمومی به آن وصل است. دوره‌ها به `Person`
  /// ارجاع می‌دهند نه `User`، و این پل بین آن دوست.
  user User?
}

model Course {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  titleEn     String
  excerpt     String
  description String
  cover       String @default("")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  instructorId String
  instructor   Person @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  level    Level
  status   ContentStatus  @default(draft)
  progress CourseProgress @default(completed)

  /// قیمت‌گذاری. در دامنه یک شیء تودرتوست (`CoursePricing`) ولی در
  /// جدول سه ستون تخت است — رابطه‌ای بودن یعنی همین. لایه ریپازیتوری
  /// این دو شکل را به هم ترجمه می‌کند و قاعده «دوره پولی مبلغ دارد»
  /// را همان‌جا نگه می‌دارد.
  pricingType         PricingType @default(free)
  priceAmount         Int?
  priceOriginalAmount Int?

  /// تاریخ انتشار درس بعدی — فقط برای دوره در حال برگزاری معنا دارد.
  nextReleaseAt DateTime?

  /// این دو از روی درس‌ها محاسبه می‌شوند، نه ورودی دستی.
  /// در لایه repository بعد از هر تغییر سرفصل بازمحاسبه می‌شوند.
  durationMinutes Int @default(0)
  lessonCount     Int @default(0)

  studentCount Int   @default(0)
  rating       Float @default(0)
  ratingCount  Int   @default(0)

  prerequisites String[]
  outcomes      String[]

  chapters Chapter[]
  projects CourseProject[]
  tags     Tag[]           @relation("CourseTags")

  isFeatured  Boolean  @default(false)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, progress])
  @@index([categoryId])
}

model Chapter {
  id          String  @id @default(cuid())
  title       String
  description String?
  order       Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id              String     @id @default(cuid())
  slug            String
  title           String
  type            LessonType
  durationMinutes Int
  isFree          Boolean    @default(false)
  order           Int

  /// نشانی ویدیو روی سرور خودمان. از `/api/media/...` سرو می‌شود.
  videoUrl       String?
  videoSizeBytes Int?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, order])
  @@index([chapterId])
}

/// پروژه عملی خروجی دوره — همان چیزی که کاوِنتادور را پروژه‌محور می‌کند.
model CourseProject {
  id          String   @id @default(cuid())
  title       String
  description String
  skills      String[]
  image       String?
  repoUrl     String?
  demoUrl     String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  /// بدنه مقاله. با مهاجرت به MDX، همین ستون متن خام را نگه می‌دارد.
  content String
  cover   String @default("")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String
  author   Person @relation(fields: [authorId], references: [id], onDelete: Restrict)

  status         ContentStatus @default(draft)
  readingMinutes Int
  viewCount      Int           @default(0)
  isFeatured     Boolean       @default(false)

  tags Tag[] @relation("ArticleTags")

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

/// برچسب جدول مستقل است نه آرایه رشته، چون روی آن فیلتر می‌زنیم.
model Tag {
  id   String @id @default(cuid())
  name String @unique

  courses  Course[]  @relation("CourseTags")
  articles Article[] @relation("ArticleTags")
}

// ─────────────────────────────────────────────────────────────
//  کاربران
// ─────────────────────────────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  name     String
  /// ورود با نام کاربری انجام می‌شود، نه ایمیل.
  username String  @unique
  email    String  @unique
  avatar   String?

  role   UserRole   @default(student)
  status UserStatus @default(active)

  /// هش رمز عبور با scrypt، در قالب `scrypt$N$نمک$هش`.
  passwordHash String

  joinedAt     DateTime  @default(now())
  lastActiveAt DateTime?

  /// پروفایل عمومی — فقط حساب مدرس و مدیر دارد، دانشجو ندارد.
  /// `onDelete: SetNull` تا حذف پروفایل، حساب را از بین نبرد.
  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  enrollments Enrollment[]

  @@index([role, status])
}

/// ثبت‌نام کاربر در دوره. رابطه چند‌به‌چند با داده اضافه، پس جدول مستقل.
model Enrollment {
  id String @id @default(cuid())

  userId   String
  courseId String

  status     EnrollmentStatus @default(active)
  enrolledAt DateTime         @default(now())

  /// شناسه درس‌هایی که کاربر تمام کرده.
  ///
  /// ⚠️ درصد پیشرفت عمداً ستون ندارد و همیشه از روی همین آرایه محاسبه
  /// می‌شود. اگر ذخیره‌اش کنیم، با افزودن یا حذف درس از سرفصل، عدد
  /// ذخیره‌شده کهنه و گمراه‌کننده می‌ماند.
  completedLessonIds String[]

  lastAccessedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

// ─────────────────────────────────────────────────────────────
//  پیام تماس
// ─────────────────────────────────────────────────────────────

model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  subject String
  message String

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}
