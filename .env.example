# ─────────────────────────────────────────────────────────────
#  کاوِنتادور — نمونه پیکربندی محیط
#
#  این فایل را به `.env.local` کپی کنید و مقادیر را پر کنید.
#  `.env.local` در گیت نادیده گرفته می‌شود.
#  مقادیر توسط zod اعتبارسنجی می‌شوند؛ مقدار نامعتبر باعث
#  شکست فوری build می‌شود، نه خطای مرموز وسط کار.
# ─────────────────────────────────────────────────────────────

# ── عمومی (در باندل مرورگر دیده می‌شود — هرگز راز نگذارید) ──

# نشانی کامل سایت. در canonical، sitemap و Open Graph استفاده می‌شود.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ایمیلی که در صفحه تماس و فوتر نمایش داده می‌شود.
NEXT_PUBLIC_CONTACT_EMAIL=kasranikshabani@yahoo.com


# ── سمت سرور (هرگز به مرورگر نمی‌رسد) ──

# منبع داده: mock (پیش‌فرض) یا prisma
# انتخاب prisma بدون DATABASE_URL خطا می‌دهد.
DATA_SOURCE=mock

# نشانی دیتابیس — فقط وقتی DATA_SOURCE=prisma لازم است.
# DATABASE_URL=postgresql://user:password@localhost:5432/kaventador

# کلید امضای کوکی نشست.
# ⚠️ در محیط تولید اجباری است و بدون آن برنامه بالا نمی‌آید.
#    با این دستور بسازید:  openssl rand -base64 32
# AUTH_SECRET=

# حساب مدیر اولیه — فقط اسکریپت seed این‌ها را می‌خواند.
# اگر تنظیم شوند، رمز حساب مدیر هنگام پرکردن دیتابیس با آن‌ها
# جایگزین می‌شود؛ پس هشِ داخل مخزن اعتبارنامه واقعی تولید نخواهد بود.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# مسیر ذخیره فایل‌های آپلودی. خالی = ./storage/uploads
# UPLOAD_DIR=/var/lib/kaventador/uploads
